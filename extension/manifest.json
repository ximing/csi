{
  "manifest_version": 3,
  "name": "cdp-bridge",
  "description": "Let AI control your real Chrome browser.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["tabs", "activeTab", "debugger", "storage", "alarms", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
