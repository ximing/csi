{
  "manifest_version": 3,
  "name": "CSI",
  "description": "__MSG_description__",
  "version": "0.2.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["tabs", "activeTab", "debugger", "storage", "alarms", "tabGroups", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
